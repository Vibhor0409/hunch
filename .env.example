# Hunch environment variables. Never commit real values.

# ---- server/.env.local (API only; never in the app) ----
# Gemini sandbox (https://exchange.sandbox.gemini.com), key with trading permission
GEMINI_API_KEY=
GEMINI_API_SECRET=
# Supabase (Project Settings > API). Service role key stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- mobile/.env (the app knows only the API address) ----
# Local testing: http://<your laptop LAN IP>:3000. Release: the Vercel production URL.
EXPO_PUBLIC_API_URL=

# ---- video/.env (video phase only, from 3:45 PM) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
